{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "系统": {
      "type": "object",
      "properties": {
        "天数": {
          "default": 1,
          "type": "number"
        },
        "当前主角": {
          "default": "吕青青",
          "type": "string"
        },
        "已登场": {
          "default": {},
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "boolean"
          }
        },
        "日常已触发": {
          "default": 0,
          "type": "number"
        }
      },
      "required": [
        "当前主角"
      ]
    },
    "吕青青": {
      "type": "object",
      "properties": {
        "塑形度": {
          "default": 0,
          "type": "number"
        },
        "心声": {
          "default": "",
          "type": "string"
        },
        "情绪": {
          "default": "平静",
          "type": "string",
          "enum": [
            "害羞",
            "情动",
            "生气",
            "平静",
            "高兴",
            "委屈",
            "被安抚",
            "吃醋"
          ]
        }
      },
      "required": [
        "心声",
        "情绪"
      ]
    },
    "吴恬恬": {
      "type": "object",
      "properties": {
        "养分值": {
          "default": 20,
          "type": "number"
        },
        "已结算阶段": {
          "default": "初始",
          "type": "string",
          "enum": [
            "初始",
            "纤细",
            "匀称",
            "丰满",
            "超重"
          ]
        },
        "心声": {
          "default": "",
          "type": "string"
        },
        "情绪": {
          "default": "平静",
          "type": "string",
          "enum": [
            "害怕",
            "平静",
            "开心",
            "委屈",
            "被安抚",
            "害羞",
            "心动",
            "发情"
          ]
        }
      },
      "required": [
        "已结算阶段",
        "心声",
        "情绪"
      ]
    },
    "心情日志": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string",
        "description": "天数"
      },
      "additionalProperties": {
        "type": "string",
        "description": "当日心情"
      }
    }
  },
  "required": [
    "系统",
    "吕青青"
  ]
}